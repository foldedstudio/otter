{
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(yarn *)"
    ],
    "ask": [
      "Bash(pnpm install*)",
      "Bash(pnpm add*)",
      "Edit(.github/workflows/**)",
      "Write(.github/workflows/**)",
      "Edit(generated/**)",
      "Write(generated/**)",
      "Edit(.env***)",
      "Write(.env***)"
    ]
  },
  "otter": {
    "guardrails": {
      "deny": [
        "production-credentials",
        "destructive-commands",
        "unapproved-network-access",
        "non-pnpm-package-manager"
      ],
      "require_approval": [
        "dependency-installs",
        "changes-to-ci-config",
        "changes-to-protected-paths"
      ],
      "protected_paths": [
        "generated/",
        ".env*"
      ],
      "tools_allowlist": [
        "claude-code",
        "codex"
      ],
      "mcp_servers_allowlist": [
        {
          "name": "github",
          "source": "ghcr.io/github/github-mcp-server",
          "version": "v2.0.2",
          "purpose": "PR and issue access for local dev and read-only CI reviewer agents"
        },
        {
          "name": "playwright",
          "source": "@playwright/mcp",
          "version": "0.0.83",
          "purpose": "browser-driven UI verification (typescript-nextjs)"
        }
      ]
    }
  }
}
