{
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(yarn *)"
    ],
    "ask": [
      "Bash(pnpm install*)",
      "Bash(pnpm add*)",
      "Edit(.github/workflows/**)",
      "Write(.github/workflows/**)",
      "Edit(generated/**)",
      "Write(generated/**)",
      "Edit(.env***)",
      "Write(.env***)"
    ]
  },
  "otter": {
    "guardrails": {
      "deny": [
        "production-credentials",
        "destructive-commands",
        "unapproved-network-access",
        "non-pnpm-package-manager"
      ],
      "require_approval": [
        "dependency-installs",
        "changes-to-ci-config",
        "changes-to-protected-paths"
      ],
      "protected_paths": [
        "generated/",
        ".env*"
      ],
      "tools_allowlist": [
        "claude-code",
        "codex"
      ],
      "mcp_servers_allowlist": []
    }
  }
}
